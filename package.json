    "adm-zip": "^0.5.16",
    "arquero": "^8.0.3",
    "chalk": "^5.6.2",
    "dotenv": "^17.3.1",
    "exa-js": "^2.4.0",
    "gray-matter": "^4.0.3",
    "iconv-lite": "^0.6.3",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
